# Broker API token (wajib)
BROKER_API_TOKEN=your_stockbit_token_here

# PostgreSQL connection (override jika tidak pakai default local)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://bandar:bandar123@localhost:5432/bandarmology

# Atau pakai split vars (fallback jika DATABASE_URL kosong)
DB_USER=bandar
DB_PASSWORD=bandar123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bandarmology

# Watchlist override (opsional)
WATCHLIST=BBCA,BBRI,BMRI,BBNI,TLKM,ASII,UNVR,GOTO,BREN,ANTM
