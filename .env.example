# PostgreSQL Database
DATABASE_URL=postgresql://adryan:adryan@localhost:5432/bandarmology
# Or use individual vars:
# DB_USER=adryan
# DB_PASSWORD=adryan
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bandarmology

# Stockbit API Token (required for broker flow data)
BROKER_API_TOKEN=your_stockbit_token_here
# Alternative name:
# STOCKBIT_TOKEN=your_stockbit_token_here

# Universe mode: watchlist | idx30 | lq45 | idx80 | all | liquid
# Default is "watchlist" (10 tickers). Use "idx80" or "all" for wider coverage.
UNIVERSE_MODE=idx80

# Broker API rate limit (requests per minute)
# Stockbit appears to allow ~40 req / 5 min = 8 req/min.
# We default to conservative 8.0. Increase only if you know the real limit.
BROKER_RATE_LIMIT=8.0

# Legacy watchlist (used when UNIVERSE_MODE=watchlist)
WATCHLIST=BBCA,BBRI,BMRI,BBNI,TLKM,ASII,UNVR,GOTO,BREN,ANTM
